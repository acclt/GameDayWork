<Window x:Class="GameOrchestrator.Views.ScheduleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="定时设置" Width="470" Height="390" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F7FB" FontFamily="Segoe UI, Microsoft YaHei UI">
  <Border Style="{StaticResource Card}" Margin="14"><StackPanel><TextBlock Text="定时启动整个队列" FontSize="18" FontWeight="SemiBold"/><CheckBox Content="启用自动执行" IsChecked="{Binding Enabled}" Margin="0,18,0,8"/><TextBlock Text="重复" Foreground="#64748B" Margin="0,8,0,5"/><ComboBox ItemsSource="{Binding RepeatValues}" SelectedItem="{Binding Config.Repeat}"/>
    <TextBlock Text="指定星期（选择 SelectedDays 时生效）" Foreground="#64748B" Margin="0,12,0,5"/><WrapPanel><CheckBox Content="一" IsChecked="{Binding Monday}" Margin="0,0,14,0"/><CheckBox Content="二" IsChecked="{Binding Tuesday}" Margin="0,0,14,0"/><CheckBox Content="三" IsChecked="{Binding Wednesday}" Margin="0,0,14,0"/><CheckBox Content="四" IsChecked="{Binding Thursday}" Margin="0,0,14,0"/><CheckBox Content="五" IsChecked="{Binding Friday}" Margin="0,0,14,0"/><CheckBox Content="六" IsChecked="{Binding Saturday}" Margin="0,0,14,0"/><CheckBox Content="日" IsChecked="{Binding Sunday}"/></WrapPanel>
    <TextBlock Text="执行时间（HH:mm:ss）" Foreground="#64748B" Margin="0,12,0,5"/><TextBox Text="{Binding Config.Time}"/><TextBlock Text="只为整个队列设置启动时间；队列内部由任务完成事件驱动。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></StackPanel></Border>
</Window>
