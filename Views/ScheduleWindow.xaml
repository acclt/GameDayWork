<Window x:Class="GameOrchestrator.Views.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:GameOrchestrator.Infrastructure"
        Title="定时设置"
        Width="470"
        Height="465"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FB"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <i:EnumDisplayConverter x:Key="EnumDisplay"/>
    <i:EnumEqualsToVisibilityConverter x:Key="EnumVisibility"/>
  </Window.Resources>

  <Border Style="{StaticResource Card}" Margin="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="定时启动整个队列" FontSize="18" FontWeight="SemiBold"/>
          <CheckBox Content="启用自动执行" IsChecked="{Binding Enabled}" Margin="0,18,0,8"/>

          <TextBlock Text="重复" Foreground="#64748B" Margin="0,8,0,5"/>
          <ComboBox ItemsSource="{Binding RepeatValues}" SelectedItem="{Binding Config.Repeat}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel Visibility="{Binding Config.Repeat,Converter={StaticResource EnumVisibility},ConverterParameter=SelectedDays}">
            <TextBlock Text="指定星期" Foreground="#64748B" Margin="0,12,0,5"/>
            <WrapPanel>
              <CheckBox Content="一" IsChecked="{Binding Monday}" Margin="0,0,14,0"/>
              <CheckBox Content="二" IsChecked="{Binding Tuesday}" Margin="0,0,14,0"/>
              <CheckBox Content="三" IsChecked="{Binding Wednesday}" Margin="0,0,14,0"/>
              <CheckBox Content="四" IsChecked="{Binding Thursday}" Margin="0,0,14,0"/>
              <CheckBox Content="五" IsChecked="{Binding Friday}" Margin="0,0,14,0"/>
              <CheckBox Content="六" IsChecked="{Binding Saturday}" Margin="0,0,14,0"/>
              <CheckBox Content="日" IsChecked="{Binding Sunday}"/>
            </WrapPanel>
          </StackPanel>

          <TextBlock Text="执行时间（HH:mm:ss）" Foreground="#64748B" Margin="0,12,0,5"/>
          <TextBox x:Name="TimeInput" TextChanged="TimeInput_TextChanged"/>
          <TextBlock x:Name="TimeError"
                     Text="请输入 00:00:00 至 23:59:59 之间的时间。"
                     Foreground="#DC2626"
                     Margin="0,5,0,0"
                     Visibility="Collapsed"/>
          <TextBlock Text="只为整个队列设置启动时间；队列内部由任务完成事件驱动。"
                     TextWrapping="Wrap"
                     Foreground="#64748B"
                     Margin="0,12,0,0"/>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,14,0,0">
        <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
        <Button Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
