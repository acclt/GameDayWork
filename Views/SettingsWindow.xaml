<Window x:Class="GameOrchestrator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameDayWork 设置" Width="700" Height="650" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="#EEF4FB" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="18">
      <TabControl>
        <TabItem Header="屏幕管理">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,18">
              <TextBlock Text="Screen Manager" FontSize="20" FontWeight="SemiBold" Foreground="#0B1735" />
              <TextBlock Text="使用每台显示器一个纯黑 Overlay 模拟息屏，不修改 Windows 电源计划。" Foreground="#6D7F9D" Margin="0,6,0,18" TextWrapping="Wrap" />

              <CheckBox Content="启用空闲假息屏" IsChecked="{Binding EnableScreenManager}" FontWeight="SemiBold" />

              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="空闲超时" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding IdleTimeoutMinutes,UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Column="2" Text="分钟（1–1440）" Foreground="#6D7F9D" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="任务前全局提前恢复" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding WakeBeforeTaskSeconds,UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Column="2" Text="秒（0–3600）" Foreground="#6D7F9D" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>

              <CheckBox Content="整条任务链结束后自动进入假息屏" IsChecked="{Binding AutoBlackoutAfterTask}" Margin="0,18,0,0" />

              <Border Background="#FFF7E8" CornerRadius="8" Padding="14" Margin="0,22,0,0">
                <TextBlock Text="请在 Windows 中手动将“关闭显示器”和“睡眠”设置为“从不”。任务准备及运行期间禁止重新黑屏。" TextWrapping="Wrap" Foreground="#805B19" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="通知">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,18">
              <TextBlock Text="企业微信群机器人" FontSize="20" FontWeight="SemiBold" Foreground="#0B1735" />
              <TextBlock Text="粘贴群机器人的 Webhook 地址后自动启用；清空地址即可停用通知。" Foreground="#6D7F9D" Margin="0,6,0,12" TextWrapping="Wrap" />

              <TextBlock Text="Webhook 地址" FontWeight="SemiBold" />
              <TextBox Text="{Binding WeComWebhookUrl,UpdateSourceTrigger=PropertyChanged}" Height="70" Margin="0,7,0,8"
                       TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top"
                       ToolTip="例如：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=..." />
              <TextBlock Text="Webhook 中包含密钥，将以明文保存在程序目录的 data/config.json；运行日志不会记录该地址。"
                         Foreground="#B45309" FontSize="12" TextWrapping="Wrap" />

              <TextBlock Text="推送事件" FontWeight="SemiBold" Margin="0,20,0,10" />
              <UniformGrid Columns="2">
                <CheckBox Content="任务应用启动" IsChecked="{Binding NotifyOnStart}" Margin="0,0,12,12" />
                <CheckBox Content="任务完成" IsChecked="{Binding NotifyOnComplete}" Margin="0,0,12,12" />
                <CheckBox Content="任务故障" IsChecked="{Binding NotifyOnFailure}" Margin="0,0,12,12" />
                <CheckBox Content="强制终止（超时或用户停止）" IsChecked="{Binding NotifyOnForcedStop}" Margin="0,0,12,12" />
              </UniformGrid>

              <Button x:Name="TestNotificationButton" Content="发送测试消息" Width="150" HorizontalAlignment="Left" Margin="0,10,0,0" Click="TestNotification_Click" />

              <Border Background="#EDF4FF" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                <TextBlock Text="通知异步发送，不会阻塞任务启动、完成检测或进程清理。发送失败会写入本地日志，但不会改变任务结果。" TextWrapping="Wrap" Foreground="#355179" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="取消" Width="100" Click="Cancel_Click" />
      <Button Content="保存并关闭" Width="130" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
