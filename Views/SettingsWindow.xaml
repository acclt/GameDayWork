<Window x:Class="GameOrchestrator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameDayWork 设置" Width="720" Height="720" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="#EEF4FB" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="18">
      <TabControl>
        <TabItem Header="应用">
          <StackPanel Margin="12,18">
            <TextBlock Text="应用设置" FontSize="20" FontWeight="SemiBold" Foreground="#0B1735" />
            <TextBlock Text="控制 GameDayWork 的启动方式。" Foreground="#6D7F9D" Margin="0,6,0,18" />

            <CheckBox Content="登录 Windows 后自动启动" IsChecked="{Binding StartWithWindows}" FontWeight="SemiBold" />
            <TextBlock Text="启用后从当前便携目录随 Windows 登录启动；是否显示主窗口由下方选项决定。移动程序目录后，启动一次程序即可自动修正路径。"
                       Foreground="#6D7F9D" Margin="24,8,0,0" TextWrapping="Wrap" />

            <CheckBox Content="使用 GameDayWork 系统服务（推荐用于无人值守）" IsChecked="{Binding UseSystemService}" FontWeight="SemiBold" Margin="0,20,0,0" />
            <TextBlock Text="服务随 Windows 启动且无需用户登录；登录后在用户会话启动桌面端并保活。启用、更新或卸载需要管理员权限，且不会把托盘、遮罩、截图或游戏任务移入 Session 0。"
                       Foreground="#6D7F9D" Margin="24,8,0,0" TextWrapping="Wrap" />

            <CheckBox Content="启动后默认隐藏到托盘" IsChecked="{Binding StartMinimizedToTray}" FontWeight="SemiBold" Margin="0,20,0,0" />
            <TextBlock Text="启用后，无论手动启动还是 Windows 开机启动，都直接进入右下角托盘；单击托盘图标可显示主页面。"
                       Foreground="#6D7F9D" Margin="24,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </TabItem>

        <TabItem Header="屏幕管理">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,18">
              <TextBlock Text="息屏管理器" FontSize="20" FontWeight="SemiBold" Foreground="#0B1735" />
              <TextBlock Text="记录显示器亮度并降至最低，再使用纯黑遮罩模拟息屏；解除遮罩时恢复原亮度。" Foreground="#6D7F9D" Margin="0,6,0,18" TextWrapping="Wrap" />

              <CheckBox Content="启用空闲假息屏" IsChecked="{Binding EnableScreenManager}" FontWeight="SemiBold" />

              <Border Background="#EDF4FF" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                <TextBlock Text="全局快捷键 Ctrl + Alt + Z：按一次进入遮罩息屏。恢复显示仍使用任意鼠标或键盘输入。"
                           TextWrapping="Wrap" Foreground="#355179" />
              </Border>

              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="空闲超时" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding IdleTimeoutMinutes,UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Column="2" Text="分钟（1–1440）" Foreground="#6D7F9D" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="任务前全局提前恢复" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding WakeBeforeTaskSeconds,UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Column="2" Text="秒（0–3600）" Foreground="#6D7F9D" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>

              <Border Background="#F7FAFE" BorderBrush="#DFE8F4" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                <StackPanel>
                  <CheckBox Content="登录页和锁屏页自动息屏" IsChecked="{Binding LockScreenDisplayTimeoutEnabled}" FontWeight="SemiBold" />
                  <TextBlock Text="仅修改当前电源方案的 SUB_VIDEO / VIDEOCONLOCK；开启前保存原值，关闭或卸载服务时恢复。需要启用系统服务。"
                             Foreground="#6D7F9D" Margin="24,7,0,0" TextWrapping="Wrap" />
                  <Grid Margin="24,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="接通电源" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding LockScreenDisplayTimeoutAcSeconds,UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Column="2" Text="秒（10–3600，默认 60）" Foreground="#6D7F9D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                  </Grid>
                  <Grid Margin="24,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="使用电池" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding LockScreenDisplayTimeoutDcSeconds,UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Column="2" Text="秒（10–3600，默认 30）" Foreground="#6D7F9D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Button Content="打开 Windows 电源和电池设置" HorizontalAlignment="Left" Margin="0,20,0,0" Click="OpenWindowsPowerSettings_Click"/>
              <TextBlock Text="该页面控制普通已解锁桌面的息屏与睡眠；登录页和锁屏页时间由 GDW 上方设置控制。"
                         Foreground="#6D7F9D" Margin="0,8,0,0" TextWrapping="Wrap"/>

              <Border Background="#EDF4FF" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                <TextBlock Text="任务链结束后返回空闲监控；只有再次连续达到空闲超时时间，才会进入假息屏。" TextWrapping="Wrap" Foreground="#355179" />
              </Border>

              <Border Background="#FFF7E8" CornerRadius="8" Padding="14" Margin="0,22,0,0">
                <TextBlock Text="普通桌面的“关闭显示器”和“睡眠”仍由 Windows 控制。任务准备及运行期间 GDW 自身不会重新进入遮罩。" TextWrapping="Wrap" Foreground="#805B19" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="通知">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,18">
              <TextBlock Text="企业微信群机器人" FontSize="20" FontWeight="SemiBold" Foreground="#0B1735" />
              <TextBlock Text="粘贴群机器人的 Webhook 地址后自动启用；清空地址即可停用通知。" Foreground="#6D7F9D" Margin="0,6,0,12" TextWrapping="Wrap" />

              <TextBlock Text="Webhook 地址" FontWeight="SemiBold" />
              <TextBox Text="{Binding WeComWebhookUrl,UpdateSourceTrigger=PropertyChanged}" Height="70" Margin="0,7,0,8"
                       TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top"
                       ToolTip="例如：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=..." />
              <TextBlock Text="Webhook 中包含密钥，将以明文保存在程序目录的 data/config.json；运行日志不会记录该地址。"
                         Foreground="#B45309" FontSize="12" TextWrapping="Wrap" />

              <TextBlock Text="推送事件" FontWeight="SemiBold" Margin="0,20,0,10" />
              <UniformGrid Columns="2">
                <CheckBox Content="任务应用启动" IsChecked="{Binding NotifyOnStart}" Margin="0,0,12,12" />
                <CheckBox Content="任务完成" IsChecked="{Binding NotifyOnComplete}" Margin="0,0,12,12" />
                <CheckBox Content="任务故障" IsChecked="{Binding NotifyOnFailure}" Margin="0,0,12,12" />
                <CheckBox Content="强制终止（超时或用户停止）" IsChecked="{Binding NotifyOnForcedStop}" Margin="0,0,12,12" />
              </UniformGrid>

              <CheckBox Content="发送任务运行与结束截图" IsChecked="{Binding CaptureTaskScreenshots}" Margin="0,4,0,0" FontWeight="SemiBold" />
              <Grid Margin="24,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="运行截图延迟" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding RunningScreenshotDelaySeconds,UpdateSourceTrigger=LostFocus}" />
                <TextBlock Grid.Column="2" Text="秒（1–3600，默认 120）" Foreground="#6D7F9D" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
              <TextBlock Foreground="#6D7F9D" Margin="24,9,0,0" TextWrapping="Wrap">
                <Run Text="启用后，任务运行满 " /><Run Text="{Binding RunningScreenshotDelaySeconds}" /><Run Text=" 秒时隐藏 GameDayWork 到托盘，并发送当前监控进程和全屏截图；任务清理完成后再次截图。" />
              </TextBlock>

              <Button x:Name="TestNotificationButton" Content="发送测试消息" Width="150" HorizontalAlignment="Left" Margin="0,10,0,0" Click="TestNotification_Click" />

              <Border Background="#EDF4FF" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                <TextBlock Text="通知异步发送，不会阻塞任务启动、完成检测或进程清理。发送失败会写入本地日志，但不会改变任务结果。" TextWrapping="Wrap" Foreground="#355179" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="取消" Width="100" Click="Cancel_Click" />
      <Button Content="保存并关闭" Width="130" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
