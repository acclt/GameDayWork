<UserControl x:Class="GameOrchestrator.Views.TaskTimeSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="24"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <ComboBox x:Name="HourSelector" Height="36" MinHeight="36" MinWidth="86" IsEditable="False" MaxDropDownHeight="250"
              ToolTip="小时；选择不定时可取消定时启动" SelectionChanged="Time_SelectionChanged"/>
    <TextBlock Grid.Column="1" Text=":" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <ComboBox x:Name="MinuteSelector" Height="36" MinHeight="36" MinWidth="66" Grid.Column="2" IsEditable="False" MaxDropDownHeight="250"
              ToolTip="分钟" SelectionChanged="Time_SelectionChanged"/>
  </Grid>
</UserControl>
